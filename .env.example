# Copy to .env and fill in. `prompt2ml init` will do this for you once M1 lands.

# --- LLM (required) ---
GOOGLE_API_KEY=

# --- Dataset sources ---
KAGGLE_USERNAME=
KAGGLE_KEY=
HUGGING_FACE_TOKEN=

# --- Web research (required) ---
TAVILY_API_KEY=

# --- Model tier overrides (optional) ---
# PROMPT2ML_CODING_MODEL=
# PROMPT2ML_REASONING_MODEL=
# PROMPT2ML_LIGHT_MODEL=

# --- Sandbox resource limits (optional) ---
# PROMPT2ML_EXEC_TIMEOUT=1800
# PROMPT2ML_SANDBOX_MEM=8g
# PROMPT2ML_SANDBOX_CPUS=4

# --- Remote GPU providers (optional; prompted when no local GPU is found) ---
# JARVISLABS_API_KEY=
# RUNPOD_API_KEY=
# COLAB_MCP_DIR=
